# PolicyLens configuration. Copy to .env and edit; every value below is optional.
#
#   cp .env.example .env
#
# The pipeline runs with none of this set. Leaving the file untouched gives you the
# keyless path: TF-IDF+SVD embeddings, BM25, the feature reranker and the extractive
# answerer. That path is what the committed evaluation report measures.

# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------
# none | anthropic | openai | gemini | ollama
# "none" selects the extractive engine, which copies sentences out of retrieved
# clauses. It cannot hallucinate, which also means groundedness near 1.0 tells you
# nothing about a model — set a real provider before quoting that metric.
POLICYLENS_LLM_PROVIDER=none

# Only the key for the provider you selected is read.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# POLICYLENS_LLM_MODEL=claude-sonnet-4-5
# POLICYLENS_LLM_TEMPERATURE=0.0
# POLICYLENS_LLM_MAX_TOKENS=1024

# Ollama, for a local model with no key at all.
# POLICYLENS_LLM_PROVIDER=ollama
# POLICYLENS_LLM_MODEL=llama3.1
# POLICYLENS_OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# tfidf-svd | sentence-transformers | openai
# tfidf-svd needs no download and no key. sentence-transformers fetches weights on
# first use, so it needs network access once.
POLICYLENS_EMBEDDING_BACKEND=tfidf-svd
# POLICYLENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# POLICYLENS_TOP_K=5
# POLICYLENS_RERANKER=lexical-features     # lexical-features | cross-encoder | none
# POLICYLENS_RETRIEVER=hybrid              # hybrid | lexical | dense

# ---------------------------------------------------------------------------
# Agent and abstention
# ---------------------------------------------------------------------------
# Raise the coverage floor to decline more often. The committed value was selected on
# the dev split by `policylens eval --sweep`; retune it rather than guessing if you
# change the corpus or the embedding backend.
# POLICYLENS_EXTRACTIVE_MIN_COVERAGE=0.3
# POLICYLENS_SELF_CHECK=1
# POLICYLENS_ENABLE_KG=1
# POLICYLENS_POLICY_GUARD=1
